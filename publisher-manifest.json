nt-size:clamp(1.9rem,5vw,3rem);}\n  .sec-intro{max-width:60ch;color:var(--muted);margin:0 0 34px;font-size:1.02rem;}\n\n  /* ---------- checklist cards (ticket / dashed) ---------- */\n  .checklist{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;}\n  .tcard{\n    position:relative;\n    border:1.5px dashed var(--line);\n    border-radius:14px;\n    background:#fff;\n    padding:24px 24px 26px;\n    overflow:hidden;\n  }\n  .tcard::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--violet);}\n  .tcard .no{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;color:var(--violet);text-transform:uppercase;}\n  .tcard h3{font-family:var(--serif);font-size:1.28rem;margin:8px 0 12px;}\n  .tick{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}\n  .tick li{position:relative;padding-left:26px;font-size:.96rem;color:var(--ink);}\n  .tick li::before{content:\"✓\";position:absolute;left:0;top:0;font-family:var(--mono);color:var(--violet);font-weight:700;}\n  .perf{margin-top:14px;padding-top:12px;border-top:1px dashed var(--line);font-family:var(--mono);font-size:.74rem;color:var(--muted);letter-spacing:.04em;}\n\n  /* ---------- steps ---------- */\n  .steps{counter-reset:s;display:flex;flex-direction:column;gap:16px;max-width:760px;}\n  .step{\n    counter-increment:s;\n    border:1.5px dashed var(--line);\n    border-radius:14px;\n    background:#fff;\n    padding:20px 22px 20px 74px;\n    position:relative;\n  }\n  .step::before{\n    content:counter(s,decimal-leading-zero);\n    position:absolute;left:22px;top:50%;transform:translateY(-50%);\n    font-family:var(--serif);font-weight:800;font-size:1.7rem;color:var(--violet);\n  }\n  .step h3{margin:0 0 4px;font-size:1.08rem;font-family:var(--serif);}\n  .step p{margin:0;color:var(--muted);font-size:.95rem;}\n\n  /* ---------- plans : single-column stacked big cards ---------- */\n  .plans{display:flex;flex-direction:column;gap:26px;}\n  .plan{\n    border:1.5px dashed var(--line);\n    border-radius:18px;\n    background:#fff;\n    padding:clamp(24px,4vw,40px);\n    position:relative;\n    display:grid;\n    grid-template-columns:1fr 1.15fr;\n    gap:30px;\n    align-items:start;\n  }\n  .plan.featured{border-style:solid;border-color:var(--violet);box-shadow:0 18px 40px -22px rgba(123,47,247,.5);}\n  .flag{position:absolute;top:-13px;left:26px;background:var(--violet);color:#fff;font-family:var(--mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;padding:5px 12px;border-radius:999px;}\n  .plan-head h3{font-family:var(--serif);font-size:1.7rem;margin:0 0 6px;}\n  .price{font-family:var(--serif);font-weight:800;font-size:clamp(2.4rem,6vw,3.4rem);line-height:1;color:var(--ink);margin:8px 0 2px;}\n  .price span{font-size:.4em;font-weight:600;color:var(--muted);}\n  .annual{font-family:var(--mono);font-size:.82rem;color:var(--violet);margin:0 0 14px;}\n  .tagline{color:var(--muted);font-size:.95rem;margin:0 0 18px;max-width:34ch;}\n  .plan ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:11px;}\n  .plan ul li{position:relative;padding-left:26px;font-size:.98rem;}\n  .plan ul li::before{content:\"—\";position:absolute;left:0;top:0;font-family:var(--mono);color:var(--violet);font-weight:700;}\n  .plan-foot{margin-top:20px;padding-top:16px;border-top:1px dashed var(--line);display:flex;flex-wrap:wrap;gap:12px;align-items:center;}\n  .btn{display:inline-flex;align-items:center;gap:8px;background:var(--violet);color:#fff;font-weight:700;padding:12px 22px;border-radius:12px;transition:transform .16s ease,background .16s ease;}\n  .btn:hover{transform:translateY(-2px);background:var(--violet-deep);}\n  .ghost{color:var(--violet);font-weight:700;padding:12px 8px;}\n  .ghost:hover{text-decoration:underline;}\n  .note-inline{font-family:var(--mono);font-size:.74rem;color:var(--muted);}\n\n  /* ---------- clients ---------- */\n  .clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;}\n  .plat{border:1.5px dashed var(--line);border-radius:14px;background:#fff;padding:22px;display:flex;flex-direction:column;gap:12px;}\n  .plat .sys{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--violet);}\n  .plat h3{margin:0;font-family:var(--serif);font-size:1.24rem;}\n  .plat p{margin:0;color:var(--muted);font-size:.92rem;}\n  .plat .dl{margin-top:auto;font-weight:700;color:var(--violet);display:inline-flex;gap:6px;align-items:center;}\n  .plat .dl.disabled{color:var(--muted);font-weight:600;}\n  .compat{margin-top:26px;border:1px dashed var(--line);border-radius:14px;padding:20px 22px;background:var(--violet-soft);}\n  .compat p{margin:0;font-size:.92rem;color:#3d3a48;}\n  .compat strong{color:var(--violet-deep);}\n\n  /* ---------- faq ---------- */\n  .faq{display:flex;flex-direction:column;gap:14px;max-width:820px;}\n  details{border:1.5px dashed var(--line);border-radius:14px;background:#fff;padding:0;overflow:hidden;transition:border-color .18s;}\n  details[open]{border-color:var(--violet);}\n  summary{cursor:pointer;list-style:none;padding:18px 22px;font-family:var(--serif);font-weight:700;font-size:1.08rem;display:flex;justify-content:space-between;gap:16px;align-items:center;}\n  summary::-webkit-details-marker{display:none;}\n  summary .pm{font-family:var(--mono);color:var(--violet);flex-shrink:0;}\n  details .body{padding:0 22px 20px;color:var(--muted);border-top:1px dashed var(--line);margin-top:2px;padding-top:16px;}\n  details .body p{margin:0 0 10px;}\n  details .body p:last-child{margin-bottom:0;}\n\n  /* ---------- closing band ---------- */\n  .close{background:var(--band-a);color:#ece9f3;padding:clamp(40px,6vw,64px) 0;}\n  .close .grid{display:grid;grid-template-columns:1.3fr 1fr;gap:34px;align-items:center;}\n  .close h2{color:#fff;}\n  .close p{color:#c9c4d6;max-width:46ch;margin:0;}\n  .close .cta{display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end;}\n  .close .btn{background:var(--violet);}\n\n  footer{background:var(--band-a);color:#8f8a9c;padding:26px 0;border-top:1px solid #2a2833;}\n  .foot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:var(--mono);font-size:.74rem;letter-spacing:.04em;}\n  .foot a{color:#b7b2c4;}\n  .foot a:hover{color:var(--violet);}\n\n  @media(max-width:760px){\n    .band-mid .grid,.plan,.close .grid{grid-template-columns:1fr;}\n    .close .cta{justify-content:flex-start;}\n    .poster h1{font-size:clamp(3rem,20vw,6rem);}\n  }\n</style><main>\n\n  \n  <header class=\"hero\">\n    <div class=\"band band-top\">\n      <div class=\"wrap brand-row\">\n        <span class=\"mark\"><b>WINDUP</b> · NETWORK TOOLKIT</span>\n        <div class=\"chips\">\n          <span class=\"chip\">三档套餐</span>\n          <span class=\"chip\">多端可用</span>\n          <span class=\"chip\">工单响应</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"band band-mid\">\n      <div class=\"wrap\">\n        <div class=\"poster\">\n          <span class=\"sub\">Turn it once, run it all day</span>\n          <h1>Windup</h1>\n        </div>\n        <div class=\"grid\">\n          <p class=\"lead\">像给发条上弦一样：<em>拧一下，就继续走。</em> 我们把繁琐的网络设置收进几条清单里——选套餐、装客户端、按步骤连上，剩下的交给 Windup 慢慢转。</p>\n          <nav class=\"jumpset\" aria-label=\"页面内跳转\">\n            <a class=\"jump\" href=\"#what\">它到底能做什么 <small>能力清单</small><span class=\"arrow\">↓</span></a>\n            <a class=\"jump\" href=\"#how\">三步怎么开始 <small>使用流程</small><span class=\"arrow\">↓</span></a>\n            <a class=\"jump\" href=\"#plans\">挑哪一档合适 <small>套餐方案</small><span class=\"arrow\">↓</span></a>\n            <a class=\"jump\" href=\"#clients\">用什么设备连 <small>客户端</small><span class=\"arrow\">↓</span></a>\n            <a class=\"jump\" href=\"#faq\">卡住了怎么办 <small>常见问题</small><span class=\"arrow\">↓</span></a>\n          </nav>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"band band-low\">\n      <div class=\"wrap strip\">\n        <span class=\"strip-note\">先读清单，再决定；不催你下单，也不藏条款。</span>\n        <div class=\"strip-links\">\n          <a class=\"mini\" href=\"#plans\">看价格</a>\n          <a class=\"mini\" href=\"#faq\">查问题</a>\n          <a class=\"mini\" href=\"#top\">回到顶部 ↑</a>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section id=\"what\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">01 — Capability Checklist</p>\n      <h2>Windup 的能力，一条条列清楚</h2>\n      <p class=\"sec-intro\">下面每张“票据”都是一组可核对的条目。凡是我们没写上的，就不算承诺；凡是你需要的，先看有没有对应那一行。</p>\n\n      <div class=\"checklist\">\n        <article class=\"tcard\">\n          <span class=\"no\">Ticket A · 连接</span>\n          <h3>稳定的日常连接</h3>\n          <ul class=\"tick\">\n            <li>按套餐分配流量额度，用完可见</li>\n            <li>多设备同时在线，数量随档位递增</li>\n            <li>线路节点池分组管理，就近接入</li>\n            <li>断线自动重连，无需手动重启</li>\n          </ul>\n          <p class=\"perf\">备注：具体额度以所选套餐为准。</p>\n        </article>\n\n        <article class=\"tcard\">\n          <span class=\"no\">Ticket B · 内容</span>\n          <h3>流媒体与访问</h3>\n          <ul class=\"tick\">\n            <li>基础版解锁常用流媒体源</li>\n            <li>旗舰版覆盖全节点原生流媒体</li>\n            <li>团队版提供 VIP 高带宽通道</li>\n            <li>路由规则可按需分流</li>\n          </ul>\n          <p class=\"perf\">备注：可解锁范围随套餐等级变化。</p>\n        </article>\n\n        <article class=\"tcard\">\n          <span class=\"no\">Ticket C · 游戏</span>\n          <h3>低延迟优化</h3>\n          <ul class=\"tick\">\n            <li>旗舰版含 IPLC 专线游戏加速</li>\n            <li>针对常见对局做链路优化</li>\n            <li>高峰时段优先调度</li>\n            <li>异常波动可提工单核查</li>\n          </ul>\n          <p class=\"perf\">备注：专线优化为旗舰及以上档位权益。</p>\n        </article>\n\n        <article class=\"tcard\">\n          <span class=\"no\">Ticket D · 支持</span>\n          <h3>服务与响应</h3>\n          <ul class=\"tick\">\n            <li>普通工单随时提交</li>\n            <li>旗舰版享 7×24 优先工单</li>\n            <li>团队版配专属客户经理</li>\n            <li>企业级需求支持定制路由</li>\n          </ul>\n          <p class=\"perf\">备注：响应优先级依档位划分。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"how\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">02 — Getting Started</p>\n      <h2>三步开始，不多不少</h2>\n      <p class=\"sec-intro\">从选档到连上，正常情况几分钟走完。每一步都是动作，不是形容词。</p>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <h3>选一个套餐</h3>\n          <p>对照下方三档，按月或按年付费。拿不准就先选基础版，够用再升级。</p>\n        </div>\n        <div class=\"step\">\n          <h3>下载对应客户端</h3>\n          <p>在“客户端”区块找到你的系统，取安装包。没有对应版本时，用兼容方式导入订阅。</p>\n        </div>\n        <div class=\"step\">\n          <h3>导入并连接</h3>\n          <p>复制订阅信息粘贴进客户端，选择节点，点连接。看到已连状态即可开始使用。</p>\n        </div>\n        <div class=\"step\">\n          <h3>需要时提工单</h3>\n          <p>连不上、掉线或额度有疑问，走工单反馈；旗舰与团队版有更高优先级。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">03 — Plans</p>\n      <h2>三档套餐，纵向排开</h2>\n      <p class=\"sec-intro\">从下往上依次是入门、主力、团队。中间那档被标了推荐——不是因为最好卖，而是多数个人用户的用量刚好落在这一格。</p>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>基础版</h3>\n            <p class=\"price\">¥15<span>/月</span></p>\n            <p class=\"annual\">按年付仅需 ¥150/年</p>\n            <p class=\"tagline\">刚接触、用量不大，先用它把流程跑通。</p>\n            <div class=\"plan-foot\">\n              <a class=\"btn\" href=\"#\">选择基础版</a>\n              <a class=\"ghost\" href=\"#faq\">额度怎么用？</a>\n            </div>\n          </div>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <span class=\"flag\">推荐 · 多数人的落点</span>\n          <div class=\"plan-head\">\n            <h3>旗舰版</h3>\n            <p class=\"price\">¥35<span>/月</span></p>\n            <p class=\"annual\">按年付仅需 ¥350/年</p>\n            <p class=\"tagline\">看得多、玩得稳，一台手机几台电脑一起用。</p>\n            <div class=\"plan-foot\">\n              <a class=\"btn\" href=\"#\">选择旗舰版</a>\n              <a class=\"ghost\" href=\"#clients\">支持哪些设备？</a>\n            </div>\n          </div>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>团队版</h3>\n            <p class=\"price\">¥85<span>/月</span></p>\n            <p class=\"annual\">按年付仅需 ¥850/年</p>\n            <p class=\"tagline\">多人协作、统一管控，带宽和路由都要专一点。</p>\n            <div class=\"plan-foot\">\n              <a class=\"btn\" href=\"#\">选择团队版</a>\n              <a class=\"ghost\" href=\"#faq\">能否定制路由？</a>\n            </div>\n          </div>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n      <p class=\"note-inline\">价格为参考档位，最终以结算页显示为准；本页不展示真实交易链接。</p>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">04 — Clients</p>\n      <h2>用什么设备连 Windup</h2>\n      <p class=\"sec-intro\">主流系统都给了入口。若某平台暂无独立客户端，可用通用代理工具导入订阅信息完成连接。</p>\n\n      <div class=\"clients\">\n        <article class=\"plat\">\n          <span class=\"sys\">macOS</span>\n          <h3>桌面客户端</h3>\n          <p>适配近期 macOS 版本的图形界面应用，一键导入订阅。</p>\n          <a class=\"dl disabled\" href=\"#\">暂未确认下载地址</a>\n        </article>\n\n        <article class=\"plat\">\n          <span class=\"sys\">Windows</span>\n          <h3>桌面客户端</h3>\n          <p>常规 Windows 环境安装即用，托盘常驻。</p>\n          <a class=\"dl disabled\" href=\"#\">暂未确认下载地址</a>\n        </article>\n\n        <article class=\"plat\">\n          <span class=\"sys\">iOS</span>\n          <h3>移动端</h3>\n          <p>iPhone / iPad 上通过兼容工具粘贴订阅信息连接。</p>\n          <a class=\"dl disabled\" href=\"#\">暂未确认下载地址</a>\n        </article>\n\n        <article class=\"plat\">\n          <span class=\"sys\">Android</span>\n          <h3>移动端</h3>\n          <p>安卓设备同样以订阅导入方式接入。</p>\n          <a class=\"dl disabled\" href=\"#\">暂未确认下载地址</a>\n        </article>\n\n        <article class=\"plat\">\n          <span class=\"sys\">路由器 / 其他</span>\n          <h3>通用方案</h3>\n          <p>支持自定义协议的路由器或第三方工具，导入后统一分流。</p>\n          <a class=\"dl disabled\" href=\"#\">暂未确认下载地址</a>\n        </article>\n      </div>\n\n      <div class=\"compat\">\n        <p><strong>关于下载地址：</strong>我们只列出确有可靠来源的安装入口。当前各平台的官方下载直链尚未核实，因此此处保持中性说明，避免误导。请以站内公告或客服提供的链接为准。</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">05 — FAQ</p>\n      <h2>常见问题，点开就有答案</h2>\n      <p class=\"sec-intro\">这里只回答能被清单证实的部分。涉及退款、日志留存等未公开的政策，我们不猜测，建议直接咨询客服。</p>\n\n      <div class=\"faq\">\n        <details>\n          <summary>Windup 到底是什么？<span class=\"pm\">＋／－</span></summary>\n          <div class=\"body\">\n            <p>一套面向个人的网络工具服务：你选套餐、装客户端、导入订阅，然后连上使用。它把配置过程压成几步，尽量让你少操心。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>三档套餐怎么选才不浪费？<span class=\"pm\">＋／－</span></summary>\n          <div class=\"body\">\n            <p>看两个数就够了：每月大概用多少流量、有几台设备要同时在线。</p>\n            <p>轻度（约 100GB、3 台以内）选基础版；日常追剧加游戏（约 300GB、5 台）选旗舰版；多人共用、需要高带宽与定制路由（约 1000GB、20 台）选团队版。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>按年和按月差在哪？<span class=\"pm\">＋／－</span></summary>\n          <div class=\"body\">\n            <p>功能与权益完全相同，只是计费周期不同。年付相当于一次性锁定一整年的档位价格：基础 ¥150/年、旗舰 ¥350/年、团队 ¥850/年。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>旗舰版的“游戏加速”具体指什么？<span class=\"pm\">＋／－</span></summary>\n          <div class=\"body\">\n            <p>旗舰版包含 IPLC 专线游戏加速优化，配合 7×24 优先工单。若遇到明显延迟波动，可直接提工单核查线路。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>为什么有些平台没给下载链接？<span class=\"pm\">＋／－</span></summary>\n          <div class=\"body\">\n            <p>我们只提供有可靠来源的入口。目前部分平台的官方直链尚未核实，为避免给出错误地址，该处保留中性说明。实际安装请以后续公告或客服提供的链接为准。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>能不能中途换档或升级？<span class=\"pm\">＋／－</span></summary>\n          <div class=\"body\">\n            <p>可以按需调整档位。具体的切换时机、剩余时长处理等操作细节，建议联系客服确认后执行。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>出问题时找谁？<span class=\"pm\">＋／－</span></summary>\n          <div class=\"body\">\n            <p>普通用户提交工单即可；旗舰版享 7×24 优先工单；团队版另有专属客户经理对接。描述现象时附上设备与时间，定位会更快。</p>\n          </div>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"close\" id=\"top-close\">\n    <div class=\"wrap\">\n      <div class=\"grid\">\n        <div>\n          <h2>拧一下，就开始转</h2>\n          <p>Windup 不追求花哨，只求每一步都能对上号：套餐写得清、步骤走得顺、问题答得实。想好了就从最上面那档试起。</p>\n        </div>\n        <div class=\"cta\">\n          <a class=\"btn\" href=\"#plans\">查看套餐</a>\n          <a class=\"btn\" href=\"#faq\">先看问答</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot\">\n    <span>© Windup · Network Toolkit</span>\n    <span>\n      <a href=\"#what\">能力</a> ·\n      <a href=\"#how\">步骤</a> ·\n      <a href=\"#plans\">套餐</a> ·\n      <a href=\"#clients\">客户端</a> ·\n      <a href=\"#faq\">FAQ</a>\n    </span>\n    <span>本页内容为品牌介绍示例，非官方站点。</span>\n  </div>\n</footer>",
